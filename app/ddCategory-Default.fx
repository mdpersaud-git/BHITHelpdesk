With({t: " " & Lower(txtWhat.Text & " " & txtDetails.Text) & " "},
If(
"bookings" in t || "booking" in t, "Bookings",
"buildergo" in t || "builder go" in t || " bgo " in t || "onlocation" in t || "on location" in t || " olw " in t || "warranty" in t, "BuilderGo/OnLocation Warranty",
"horizon" in t, "Horizon",
"newstar" in t || "new star" in t, "NewStar",
"salexpress" in t || "salesxpress" in t || "sales xpress" in t || "sale xpress" in t || " soms " in t || "nseweb" in t, "SaleXpress",
"salefish" in t || "sale fish" in t || "sales fish" in t, "SaleFish",
"informxl" in t || "inform xl" in t || "in-form" in t, "InFormXL",
" vpn " in t || "remote access" in t || "work from home" in t, "VPN",
"printer" in t || "print" in t || "toner" in t || "scanner" in t || "scanning" in t, "Printer",
"password" in t || "sign in" in t || "signin" in t || "sign-in" in t || "locked out" in t || "login" in t || "log in" in t || " mfa " in t || "authenticator" in t, "Password or Sign-In",
"new hire" in t || "new user" in t || "new employee" in t || "onboard" in t || "new staff" in t, "New User Setup",
"landline" in t || "desk phone" in t || "voicemail" in t || "extension" in t, "Landline",
"ipad" in t || "iphone" in t || " cell" in t || "mobile" in t || "tablet" in t || "android" in t, "Mobile (iPad / Cell)",
"mouse" in t || "keyboard" in t || "monitor" in t || "screen" in t || "docking" in t || "headset" in t || "webcam" in t, "Mouse / Keyboard / Monitor",
"teams" in t, "Teams",
"outlook" in t || "email" in t || "e-mail" in t || "mailbox" in t, "Email",
"access to" in t || "permission" in t || "shared drive" in t || "shared mailbox" in t || "access request" in t, "Access Request",
"excel" in t || "ms word" in t || "microsoft word" in t || "powerpoint" in t || "adobe" in t || "acrobat" in t || "install" in t || "software" in t || "sharepoint" in t || "onedrive" in t, "Application",
"laptop" in t || "computer" in t || "desktop" in t || "frozen" in t || " pc " in t || "blue screen" in t || "slow" in t, "Laptop / Desktop",
"Other"))
