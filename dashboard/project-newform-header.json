{
  "elmType": "div",
  "style": {
    "display": "flex",
    "flex-direction": "column",
    "padding": "14px 18px 13px",
    "background-color": "#0f172a",
    "border-radius": "8px",
    "border-bottom": "2px solid #2563eb",
    "color": "#ffffff",
    "margin-bottom": "8px"
  },
  "children": [
    {
      "elmType": "div",
      "txtContent": "BRANTHAVEN > Projects",
      "style": {
        "font-size": "10px",
        "font-weight": "600",
        "letter-spacing": "0.6px",
        "text-transform": "uppercase",
        "color": "#93a1c4",
        "margin-bottom": "8px"
      }
    },
    {
      "elmType": "div",
      "style": {
        "display": "flex",
        "align-items": "center",
        "gap": "12px"
      },
      "children": [
        {
          "elmType": "div",
          "style": {
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "width": "40px",
            "height": "40px",
            "border-radius": "9px",
            "background-color": "rgba(255,255,255,0.12)",
            "flex-shrink": "0"
          },
          "children": [
            {
              "elmType": "span",
              "attributes": {
                "iconName": "ProjectCollection"
              },
              "style": {
                "font-size": "21px",
                "color": "#ffffff"
              }
            }
          ]
        },
        {
          "elmType": "div",
          "children": [
            {
              "elmType": "div",
              "txtContent": "=if([$Title] == '', 'New IT Project', [$Title])",
              "style": {
                "font-size": "24px",
                "font-weight": "700",
                "letter-spacing": "-0.3px",
                "line-height": "1.15",
                "color": "#ffffff"
              }
            },
            {
              "elmType": "div",
              "txtContent": "=if([$Title] == '', 'Add a project to the IT Projects tracker', 'IT Projects tracker')",
              "style": {
                "font-size": "12px",
                "color": "#9fb0d6",
                "margin-top": "2px"
              }
            }
          ]
        }
      ]
    }
  ]
}
