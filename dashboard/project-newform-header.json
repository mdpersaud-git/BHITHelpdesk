{
  "elmType": "div",
  "style": {
    "display": "flex",
    "align-items": "center",
    "gap": "14px",
    "padding": "18px 20px",
    "background-color": "#2563eb",
    "border-radius": "8px",
    "color": "#ffffff",
    "margin-bottom": "8px"
  },
  "children": [
    {
      "elmType": "div",
      "style": {
        "display": "flex",
        "align-items": "center",
        "justify-content": "center",
        "width": "42px",
        "height": "42px",
        "border-radius": "10px",
        "background-color": "rgba(255,255,255,0.18)",
        "flex-shrink": "0"
      },
      "children": [
        {
          "elmType": "span",
          "attributes": {
            "iconName": "ProjectCollection"
          },
          "style": {
            "font-size": "20px",
            "color": "#ffffff"
          }
        }
      ]
    },
    {
      "elmType": "div",
      "children": [
        {
          "elmType": "div",
          "txtContent": "=if([$Title] == '', 'New IT Project', [$Title])",
          "style": {
            "font-size": "18px",
            "font-weight": "600",
            "line-height": "1.2",
            "color": "#ffffff"
          }
        },
        {
          "elmType": "div",
          "txtContent": "=if([$Title] == '', 'Add a project to the IT Projects tracker', 'IT Projects tracker')",
          "style": {
            "font-size": "12px",
            "color": "#dbe7ff",
            "margin-top": "2px"
          }
        }
      ]
    }
  ]
}
