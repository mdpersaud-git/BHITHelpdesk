{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "flex",
    "align-items": "center",
    "height": "100%"
  },
  "children": [
    {
      "elmType": "span",
      "txtContent": "@currentField",
      "style": {
        "background-color": "=if(@currentField=='Not Started','#edebe9',if(@currentField=='In Progress','#deecf9',if(@currentField=='On Hold','#fff4ce',if(@currentField=='Waiting on Vendor/Approval','#efe6f8',if(@currentField=='Completed','#dff6dd',if(@currentField=='Cancelled','#fde7e9','#edebe9'))))))",
        "color": "=if(@currentField=='Not Started','#605e5c',if(@currentField=='In Progress','#004578',if(@currentField=='On Hold','#6d5700',if(@currentField=='Waiting on Vendor/Approval','#5c2e91',if(@currentField=='Completed','#0b6a0b',if(@currentField=='Cancelled','#a4262c','#323130'))))))",
        "padding": "2px 10px",
        "border-radius": "12px",
        "font-size": "12px",
        "font-weight": "600",
        "white-space": "nowrap",
        "overflow": "hidden",
        "text-overflow": "ellipsis",
        "max-width": "100%",
        "display": "inline-block",
        "line-height": "20px"
      }
    }
  ]
}
